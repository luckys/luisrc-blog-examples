{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "memory-limit"
  },
  "spec": {
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "containers": [
      {
        "name": "api",
        "image": "LAB_IMAGE_V1",
        "imagePullPolicy": "Never",
        "command": [
          "node",
          "-e",
          "const held=Buffer.alloc(256*1024*1024,1);setInterval(()=>held[0],1000)"
        ],
        "resources": {
          "requests": {
            "cpu": "50m",
            "memory": "32Mi"
          },
          "limits": {
            "cpu": "250m",
            "memory": "64Mi"
          }
        }
      }
    ]
  }
}
