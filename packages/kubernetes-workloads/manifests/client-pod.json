{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "dns-client",
    "labels": {
      "experiment": "service-client"
    }
  },
  "spec": {
    "serviceAccountName": "catalogue",
    "automountServiceAccountToken": false,
    "containers": [
      {
        "name": "client",
        "image": "LAB_IMAGE_V1",
        "imagePullPolicy": "Never",
        "command": [
          "node",
          "-e",
          "setInterval(()=>{},1000)"
        ],
        "resources": {
          "requests": {
            "cpu": "10m",
            "memory": "32Mi"
          },
          "limits": {
            "cpu": "100m",
            "memory": "64Mi"
          }
        }
      }
    ]
  }
}
