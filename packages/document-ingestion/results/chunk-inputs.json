          "id": "83677e54d9c1d3631ea90fb31fb4e355715cdac81e92df5776fb90ee7cee02fd:55:67",
          "documentId": "RUNBOOK",
          "first": 55,
          "last": 67,
          "start": 356,
          "end": 437,
          "text": "Mantener dos copias en ubicaciones diferentes evita depender de un único volumen.",
