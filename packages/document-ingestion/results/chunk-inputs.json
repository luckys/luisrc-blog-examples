        {
          "id": "83677e54d9c1d3631ea90fb31fb4e355715cdac81e92df5776fb90ee7cee02fd:14:23",
          "documentId": "RUNBOOK",
          "first": 14,
          "last": 23,
          "start": 107,
          "end": 163,
          "text": "La prueba debe restaurar datos y comprobar su contenido.",
