{
  "type": "function",
  "function": {
    "name": "submit_entities",
    "description": "Proponer entidades del documento activo; no persiste ni ejecuta acciones externas.",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "Entity": {
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "PER",
                "ORG"
              ],
              "title": "Type",
              "type": "string"
            },
            "text": {
              "maxLength": 120,
              "minLength": 1,
              "pattern": "\\S",
              "title": "Text",
              "type": "string"
            },
            "quote": {
              "maxLength": 500,
              "minLength": 1,
              "pattern": "\\S",
              "title": "Quote",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text",
            "quote"
          ],
          "title": "Entity",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "entities": {
          "items": {
            "$ref": "#/$defs/Entity"
          },
          "maxItems": 8,
          "title": "Entities",
          "type": "array"
        }
      },
      "required": [
        "entities"
      ],
      "title": "EntityExtraction",
      "type": "object"
    }
  }
}
